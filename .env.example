# Plumb environment — copy to .env and fill locally.
# .env is gitignored. NEVER commit a real value (AGENTS.md guardrail 7).
# LIVE KEYS DO NOT EXIST BEFORE PHASE 9 (guardrail 10). Leave the OKX_* block empty until then.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# fake | live
# fake = deterministic fixtures, zero network, zero spend. The default everywhere,
# including every test. Only Phase 9+ operations set this to live.
PLUMB_MODE=fake

# Path to the SQLite file holding the persisted risk-governor state, the signal
# ledger and the reconciliation log. Guardrail 6: a restart never resets a counter.
PLUMB_DB_PATH=./data/plumb.db

# Display timezone for operator-facing output. ALL internal accounting is UTC and
# is not affected by this. The competition clock is UTC+8 — conversions are always
# explicit in code (gotcha 8), never inferred from this variable.
PLUMB_TZ=UTC

# ---------------------------------------------------------------------------
# OKX — Agent Trade Kit (Phase 9+ ONLY)
# Sub-account API key, trade-only, withdrawals disabled. NEVER the main account.
# ---------------------------------------------------------------------------

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# The OKX UID of the competition sub-account — the accounting basis for scoring.
OKX_UID=

# ---------------------------------------------------------------------------
# Model providers
# Guardrail 4: models produce labels and prose only. No number an LLM emits ever
# reaches an order — not entry, size, leverage, stop or TP.
# ---------------------------------------------------------------------------

# DeepSeek — regime labels. Cheap, bounded, schema-validated.
DEEPSEEK_API_KEY=

# Claude — signal rationale and the daily written review.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------

# Webhook that receives halts, kill-switch trips, orphan fills and daily reviews.
PLUMB_ALERT_WEBHOOK=

# Bearer token guarding the operator-only admin surface (halt, re-arm, state dump).
PLUMB_ADMIN_TOKEN=
