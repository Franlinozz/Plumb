{
  "name": "plumb",
  "version": "0.11.0",
  "private": true,
  "description": "Plumb — a risk-first perpetual-futures signal service and Trading ASP on OKX.AI. Every signal, measured before it's sent.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "backtest": "node scripts/backtest.mjs",
    "paper": "node scripts/phase-pending.mjs paper 8 \"paper-trading loop against live market data, fake execution\"",
    "record-fixtures": "node scripts/record-fixtures.mjs",
    "snapshot": "node scripts/live-snapshot.mjs",
    "backfill": "node scripts/backfill.mjs",
    "divergence": "node scripts/indicator-divergence.mjs",
    "probe:regimes": "node scripts/probe-regimes.mjs",
    "probe:strategies": "node scripts/probe-strategies.mjs",
    "replay": "node scripts/replay-signals.mjs",
    "hostile": "node scripts/hostile-sim.mjs",
    "demo-session": "node scripts/demo-session.mjs",
    "demo-venue": "node scripts/demo-venue-session.mjs",
    "measure": "node scripts/measure-tables.mjs",
    "feed-sample": "node scripts/feed-sample.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true
  }
}
