[Unit]
Description=Plumb nightly backup (VACUUM INTO + restore verification)
RequiresMountsFor=/var/lib/plumb

[Service]
Type=oneshot
WorkingDirectory=/opt/plumb
EnvironmentFile=/root/.plumb/runner.env
ExecStart=/root/.nvm/versions/node/v22.22.3/bin/node /opt/plumb/scripts/backup.mjs
StandardOutput=append:/var/log/plumb/backup.log
StandardError=append:/var/log/plumb/backup.log
