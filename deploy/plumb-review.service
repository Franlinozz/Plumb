[Unit]
Description=Plumb daily review (previous UTC day)
RequiresMountsFor=/var/lib/plumb

[Service]
Type=oneshot
WorkingDirectory=/opt/plumb
EnvironmentFile=/root/.plumb/runner.env
ExecStart=/root/.nvm/versions/node/v22.22.3/bin/node /opt/plumb/scripts/daily-review.mjs
StandardOutput=append:/var/log/plumb/review.log
StandardError=append:/var/log/plumb/review.log
