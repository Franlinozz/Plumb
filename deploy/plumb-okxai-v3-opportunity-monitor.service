[Unit]
Description=Plumb read-only BTC/SOL competition opportunity monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/plumb-okxai
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
EnvironmentFile=/root/.plumb/discord.env
ExecStart=/usr/bin/node /root/plumb-okxai/scripts/competition-v3-discord-alert.mjs BTC-USDT-SWAP
ExecStart=/usr/bin/node /root/plumb-okxai/scripts/competition-v3-discord-alert.mjs SOL-USDT-SWAP
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/plumb-okxai
StandardOutput=journal
StandardError=journal
