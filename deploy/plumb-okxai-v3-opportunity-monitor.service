[Unit]
Description=Plumb one-shot authorised BTC/ETH/SOL competition entry monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=7min
UMask=0077
WorkingDirectory=/root/plumb-okxai
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
EnvironmentFile=/root/.plumb/discord.env
EnvironmentFile=/root/.plumb/competition-auto.env
Environment=PLUMB_ASP_AGENT_ID=10746
ExecStart=/usr/bin/node /root/plumb-okxai/scripts/competition-second-entry-auto.mjs BTC-USDT-SWAP
ExecStart=/usr/bin/node /root/plumb-okxai/scripts/competition-second-entry-auto.mjs ETH-USDT-SWAP
ExecStart=/usr/bin/node /root/plumb-okxai/scripts/competition-second-entry-auto.mjs SOL-USDT-SWAP
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/plumb-okxai
StandardOutput=journal
StandardError=journal
