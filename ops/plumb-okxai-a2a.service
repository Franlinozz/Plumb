[Unit]
Description=Plumb OKX.AI subscription delivery
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/plumb-okxai
Environment=PLUMB_ASP_AGENT_ID=10746
Environment=PLUMB_ASP_CHAIN_INDEX=196
Environment=PLUMB_A2A_STATE=/var/lib/plumb-okxai/asp-delivery.db
ExecStart=/usr/bin/node /root/plumb-okxai/scripts/asp-autopilot.mjs
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/plumb-okxai /root/.onchainos /root/.okx-agent-task

[Install]
WantedBy=multi-user.target
