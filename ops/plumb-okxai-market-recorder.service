[Unit]
Description=Plumb competition public-market observation recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/plumb-okxai
Environment=PLUMB_COMPETITION_MARKET_DB=/var/lib/plumb-okxai/market-observations.db
ExecStart=/usr/bin/node /root/plumb-okxai/scripts/competition-market-recorder.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/plumb-okxai
StandardOutput=journal
StandardError=journal
